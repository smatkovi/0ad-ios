+/**
+ * What has to outlive SDL_main on iOS.
+ *
+ * UIKit owns the run loop. SDL calls SDL_main from a run-loop timer callback
+ * (-[SDLUIKitDelegate postFinishLaunch]), so a frame loop that never returns
+ * runs *inside* that callback -- and SDL_PollEvent then enters the same run
+ * loop a second time from in there. Four seconds of that and libdispatch
+ * dereferences a null pointer. Switching SDL's pump off made the crash go away
+ * and nothing render, which is what settled the diagnosis.
+ *
+ * So the loop is turned around: SDL_main registers the frame with UIKit and
+ * returns, and each frame then starts *from* the run loop. SDL's delegate is
+ * built for this -- it deliberately does not exit when SDL_main returns, and it
+ * switches its own event pump off at that point, so nothing nests any more.
+ *
+ * What the frame needs are locals of RunGameOrAtlas on every other platform.
+ * Here they live in one object that is created once and never destroyed: iOS
+ * ends the process, it does not unwind it.
+ */
+struct IosSession
+{
+	FileLogger logger;
+	std::optional<ScriptInterface> guiScriptInterface;
+	// A pointer, because RL::Interface is neither copyable nor movable: it can
+	// only be built where it is going to stay. (That is also why the desktop
+	// code below wraps its construction in a lambda -- see the comment there.)
+	std::optional<RL::Interface>* rlInterface{nullptr};
+	int fixedFrameFrequency{0};
+};
+
+IosSession* g_IosSession{nullptr};
+
+void IosFrameCallback(void*);
+
+/**
+ * Say something where it can actually be read.
+ *
+ * debug_printf goes to stdout, and the stdout of an app started with
+ * `simctl launch` goes nowhere -- only os_log reaches the system log. A file in
+ * the app container is the one channel that always arrives, and CI can fetch it
+ * with `simctl get_app_container`. SDL_Log goes to NSLog on iOS, so it is worth
+ * having as well.
+ */
+void IosNote(const char* format, ...)
+{
+	char line[256];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(line, sizeof(line), format, args);
+	va_end(args);
+
+	SDL_Log("%s", line);
+
+	const char* const home{getenv("HOME")};
+	if (!home)
+		return;
+	char path[512];
+	snprintf(path, sizeof(path), "%s/Documents/ios-frames.txt", home);
+	if (FILE* const file = fopen(path, "a"))
+	{
+		fprintf(file, "%s\n", line);
+		fclose(file);
+	}
+}
+
+/**
+ * Registering the frame callback has to wait for the next turn of the run loop.
+ *
+ * SDL hangs its CADisplayLink on view.window.screen, and while SDL_main is
+ * still running UIKit has not put the window on a screen yet -- the link comes
+ * out nil and no frame is ever drawn. The app then sits there alive and idle:
+ * seven seconds of CPU in four minutes, a log that stops growing, and a screen
+ * showing the renderer's clear colour.
+ *
+ * dispatch_async puts it after the return from SDL_main, which is exactly when
+ * the window is in place.
+ */
+void IosStartFrames(void*)
+{
+	SDL_Window* const window{g_VideoMode.GetWindow()};
+	const int result{SDL_iPhoneSetAnimationCallback(window, 1, &IosFrameCallback, nullptr)};
+	// Both go to stdout, which the simulator's system log keeps: the question
+	// "is the frame being called at all" is otherwise indistinguishable from
+	// "the frame is being called and does nothing".
+	IosNote("window %p, animation callback %s",
+		static_cast<void*>(window), result == 0 ? "registered" : SDL_GetError());
+	if (result != 0)
+		LOGERROR("Cannot hand the frame to UIKit: %s", SDL_GetError());
+}
+
+void IosFrameCallback(void*)
+{
+	static int frames{0};
+	if (frames < 3 || frames % 300 == 0)
+		IosNote("frame %d", frames);
+	++frames;
+
+	if (g_Shutdown != ShutdownType::None)
+	{
+		// The desktop would unwind here and possibly restart. On iOS the system
+		// ends the process; carrying on would leave UIKit calling into an
+		// engine that is shutting itself down.
+		SDL_iPhoneSetAnimationCallback(g_VideoMode.GetWindow(), 1, nullptr, nullptr);
+		return;
+	}
+	std::optional<RL::Interface>* const rlInterface{g_IosSession->rlInterface};
+	Frame(rlInterface && *rlInterface ? &**rlInterface : nullptr,
+		g_IosSession->fixedFrameFrequency);
+}
+}
+#endif // OS_IOS
