+namespace
+{
+
+/**
+ * Eight megabytes per request, six requests at a time.
+ *
+ * This is what aria2c does, and doing it in the app is not a preference but the
+ * only option: iOS starts no child processes, so there is no aria2c, no curl
+ * binary and no unzip either -- which is also why the data is republished as
+ * plain zips the engine reads in place (tools/make-data-release.sh).
+ *
+ * Six because one connection to a CDN is bandwidth-limited far below what a
+ * phone on wifi can take, and because NSURLSession would otherwise open four:
+ * HTTPMaximumConnectionsPerHost has to be raised to match, or "parallel" is a
+ * word and nothing else.
+ */
+constexpr long long CHUNK = 8 * 1024 * 1024;
+constexpr int PARALLEL = 6;
+
+// A pass fetches every chunk that is still missing, so a failed chunk is not a
+// failed download -- it is one more pass. Four of them, with a pause that grows,
+// is enough for a train leaving a tunnel and not enough to hang forever.
+constexpr int PASSES = 4;
+
+// Keep this much free after the download; a phone that is full should say so
+// before it spends an hour on a transfer it cannot finish.
+constexpr long long SPARE = 200LL * 1024 * 1024;
+
+/**
+ * Where one part of a file comes from.
+ *
+ * A file can have more than one, because a release asset may not be larger than
+ * 2 GiB and public.zip is 3.5 GB. The parts are not an archive format and
+ * nothing is joined together afterwards: each one is simply written at its own
+ * offset in the file, which is what the chunk machinery below does anyway.
+ */
+struct Source
+{
+	std::string url;
+	long long offset{0};	// where in the finished file this part begins
+	long long length{0};
+};
+
+struct Entry
+{
+	std::string path;	// relative to the data root, e.g. mods/public/public.zip
+	std::string sha256;	// lower case hex, of the whole file
+	long long size{0};
+	std::vector<Source> sources;
+};
+
+/**
+ * One file being fetched, and how far it has got.
+ *
+ * `state` has one character per chunk, '1' once that chunk is on disk, and it is
+ * written to `statePath` after every chunk: this is what makes the download
+ * survive being interrupted, which at 3.5 GB it will be.
+ */
+struct FileJob
+{
+	Entry entry;
+	int fd{-1};
+	std::string target;
+	std::string statePath;
+	std::string state;
+	long long chunks{0};
+};
+
+struct Progress
+{
+	long long total{0};
+	std::atomic<long long> done{0};
+	std::atomic<double> reportedAt{0};
+};
+
+// ---------------------------------------------------------------------------
+// Notes
+//
+// The same file the frame notes go to (see main.cpp): an app started by
+// `simctl launch` has nowhere to print, so this is the only way to see what
+// happened -- on the device too, where UIFileSharingEnabled makes it reachable
+// from the Files app.
+
+void Note(NSString* format, ...) NS_FORMAT_FUNCTION(1, 2);
+void Note(NSString* format, ...)
+{
+	va_list args;
+	va_start(args, format);
+	NSString* text = [[NSString alloc] initWithFormat:format arguments:args];
+	va_end(args);
+
+	NSLog(@"0ad: %@", text);
+
+	NSString* path = [NSHomeDirectory()
+		stringByAppendingPathComponent:@"Documents/ios-frames.txt"];
+	if (FILE* file = std::fopen(path.UTF8String, "a"))
+	{
+		std::fprintf(file, "download: %s\n", text.UTF8String);
+		std::fclose(file);
+	}
+	[text release];
+}
+
+// ---------------------------------------------------------------------------
+// Paths
+
+NSString* Str(const std::string& s)
+{
+	return [NSString stringWithUTF8String:s.c_str()];
+}
+
+std::string DataFinal()
+{
+	const std::string appSupport = osx_GetAppSupportPath();
+	return appSupport.empty() ? std::string() : appSupport + "/0ad/data";
+}
+
+// Downloaded into ".part" and renamed when everything is there and every hash
+// matches: Paths::RootData() only asks whether the directory exists, so a
+// half-finished one must not carry that name.
+std::string DataPartial()
+{
+	const std::string final = DataFinal();
+	return final.empty() ? std::string() : final + ".part";
+}
+
+std::string ManifestPath()
+{
+	const std::string resources = osx_GetBundleResourcesPath();
+	return resources.empty() ? std::string() : resources + "/download.manifest";
+}
+
+bool DirExists(const std::string& path)
+{
+	if (path.empty())
+		return false;
+	BOOL isDir = NO;
+	return [[NSFileManager defaultManager] fileExistsAtPath:Str(path) isDirectory:&isDir] && isDir;
+}
+
+bool MakeDirs(const std::string& path)
+{
+	return [[NSFileManager defaultManager] createDirectoryAtPath:Str(path)
+		withIntermediateDirectories:YES attributes:nil error:nil] == YES;
+}
+
+// ---------------------------------------------------------------------------
+// The manifest
+//
+// Tab-separated, generated by tools/make-data-release.sh and shipped inside the
+// bundle, so the sizes and hashes are the ones this build was made against and
+// not whatever a server says today.
+
+bool ReadManifest(std::vector<Entry>& entries, std::string& error)
+{
+	const std::string path = ManifestPath();
+	if (path.empty())
+	{
+		error = "no bundle to read the manifest from";
+		return false;
+	}
+	NSString* text = [NSString stringWithContentsOfFile:Str(path)
+		encoding:NSUTF8StringEncoding error:nil];
+	if (!text)
+	{
+		error = "the app has no download.manifest -- it was built without one";
+		return false;
+	}
+
+	for (NSString* rawLine in [text componentsSeparatedByString:@"\n"])
+	{
+		NSString* line = [rawLine stringByTrimmingCharactersInSet:
+			[NSCharacterSet whitespaceCharacterSet]];
+		if (line.length == 0 || [line hasPrefix:@"#"])
+			continue;
+		NSArray<NSString*>* fields = [line componentsSeparatedByString:@"\t"];
+		if (fields.count != 6)
+		{
+			error = "the manifest has a line that is not six fields";
+			return false;
+		}
+		const std::string path = fields[0].UTF8String;
+		const long long size = fields[1].longLongValue;
+		const std::string hash = [fields[2] lowercaseString].UTF8String;
+		Source source;
+		source.url = fields[3].UTF8String;
+		source.offset = fields[4].longLongValue;
+		source.length = fields[5].longLongValue;
+
+		// The manifest decides where files land, so it may not point outside.
+		if (path.empty() || path[0] == '/' || path.find("..") != std::string::npos)
+		{
+			error = "the manifest names a path outside the data directory";
+			return false;
+		}
+		if (size < 0 || hash.size() != 64 || source.length <= 0 ||
+			source.offset < 0 || source.offset + source.length > size ||
+			source.url.compare(0, 8, "https://") != 0)
+		{
+			error = "the manifest has a bad size, hash, offset or URL";
+			return false;
+		}
+
+		// Several lines with the same path are the parts of one file.
+		auto existing = std::find_if(entries.begin(), entries.end(),
+			[&path](const Entry& entry) { return entry.path == path; });
+		if (existing == entries.end())
+		{
+			Entry entry;
+			entry.path = path;
+			entry.size = size;
+			entry.sha256 = hash;
+			entry.sources.push_back(std::move(source));
+			entries.push_back(std::move(entry));
+		}
+		else if (existing->size != size || existing->sha256 != hash)
+		{
+			error = "the manifest gives " + path + " two different sizes";
+			return false;
+		}
+		else
+			existing->sources.push_back(std::move(source));
+	}
+	if (entries.empty())
+	{
+		error = "the manifest lists nothing to download";
+		return false;
+	}
+
+	for (Entry& entry : entries)
+	{
+		std::sort(entry.sources.begin(), entry.sources.end(),
+			[](const Source& a, const Source& b) { return a.offset < b.offset; });
+		long long at = 0;
+		for (std::size_t i = 0; i < entry.sources.size(); ++i)
+		{
+			const Source& source = entry.sources[i];
+			// Every part has to begin on a chunk boundary and, except for the
+			// last one, end on one as well. That is what lets a chunk be fetched
+			// from exactly one part -- tools/make-data-release.sh cuts at 1792
+			// MiB, which is 224 chunks.
+			const bool last = i + 1 == entry.sources.size();
+			if (source.offset != at || source.offset % CHUNK != 0 ||
+				(!last && source.length % CHUNK != 0))
+			{
+				error = entry.path + " is cut into parts that do not line up";
+				return false;
+			}
+			at += source.length;
+		}
+		if (at != entry.size)
+		{
+			error = entry.path + " is missing a part";
+			return false;
+		}
+	}
+	return true;
+}
+
+/**
+ * Which part of the file does this offset come from?
+ */
+const Source* SourceAt(const Entry& entry, long long offset)
+{
+	for (const Source& source : entry.sources)
+		if (offset >= source.offset && offset < source.offset + source.length)
+			return &source;
+	return nullptr;
+}
+
+// ---------------------------------------------------------------------------
+// Chunk bookkeeping
+
+long long ChunkLength(const FileJob& job, long long index)
+{
+	return std::min<long long>(CHUNK, job.entry.size - index * CHUNK);
+}
+
+bool AllDone(const FileJob& job)
+{
+	return job.state.find('0') == std::string::npos;
+}
+
+long long DoneBytes(const FileJob& job)
+{
+	long long done = 0;
+	for (long long i = 0; i < job.chunks; ++i)
+		if (job.state[i] == '1')
+			done += ChunkLength(job, i);
+	return done;
+}
+
+void WriteState(const FileJob& job)
+{
+	if (FILE* file = std::fopen(job.statePath.c_str(), "w"))
+	{
+		std::fwrite(job.state.data(), 1, job.state.size(), file);
+		std::fclose(file);
+	}
+}
+
+void ReadState(FileJob& job)
+{
+	job.state.assign(static_cast<std::size_t>(job.chunks), '0');
+	if (FILE* file = std::fopen(job.statePath.c_str(), "r"))
+	{
+		std::string stored(static_cast<std::size_t>(job.chunks), '0');
+		const std::size_t read = std::fread(&stored[0], 1, stored.size(), file);
+		// A short or long state file belongs to a different manifest: start over
+		// rather than trust an offset that has moved.
+		if (read == stored.size() && std::fgetc(file) == EOF)
+			job.state = stored;
+		std::fclose(file);
+	}
+}
+
+bool WriteAt(int fd, const void* data, std::size_t length, long long offset)
+{
+	const char* at = static_cast<const char*>(data);
+	std::size_t left = length;
+	while (left > 0)
+	{
+		const ssize_t written = pwrite(fd, at, left, offset);
+		if (written <= 0)
+			return false;
+		at += written;
+		left -= static_cast<std::size_t>(written);
+		offset += written;
+	}
+	return true;
+}
+
+bool VerifyHash(const std::string& path, const std::string& expected)
+{
+	FILE* file = std::fopen(path.c_str(), "r");
+	if (!file)
+		return false;
+	CC_SHA256_CTX context;
+	CC_SHA256_Init(&context);
+	std::vector<unsigned char> buffer(1024 * 1024);
+	while (const std::size_t got = std::fread(buffer.data(), 1, buffer.size(), file))
+		CC_SHA256_Update(&context, buffer.data(), static_cast<CC_LONG>(got));
+	const bool ok = std::ferror(file) == 0;
+	std::fclose(file);
+
+	unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+	CC_SHA256_Final(digest, &context);
+	if (!ok)
+		return false;
+
+	std::string hex;
+	hex.reserve(sizeof(digest) * 2);
+	for (unsigned char byte : digest)
+	{
+		char pair[3];
+		std::snprintf(pair, sizeof(pair), "%02x", byte);
+		hex += pair;
+	}
+	return hex == expected;
+}
+
+} // anonymous namespace
+
+// ---------------------------------------------------------------------------
+// The screen
+//
+// A window of our own, because SDL has not made one yet: the engine asks for it
+// much later, and by then this one is gone again. Everything here hops onto the
+// main queue itself, so the transfer can call it from wherever it is.
+
+@interface ZeroADDownloadScreen : NSObject
+- (void)show;
+- (void)setLine:(NSString*)line detail:(NSString*)detail fraction:(double)fraction;
+- (void)showError:(NSString*)text retry:(void (^)(void))retry;
+- (void)hide;
+@end
+
+@implementation ZeroADDownloadScreen
+{
+	UIWindow* _window;
+	UILabel* _line;
+	UILabel* _detail;
+	UIProgressView* _bar;
+	UIButton* _retry;
+}
+
+- (void)show
+{
+	dispatch_async(dispatch_get_main_queue(), ^{
+		if (_window)
+			return;
+		_window = [[UIWindow alloc] initWithFrame:[UIScreen mainScreen].bounds];
+		UIViewController* controller = [[UIViewController alloc] init];
+		controller.view.backgroundColor = [UIColor blackColor];
+
+		const CGRect bounds = controller.view.bounds;
+		const CGFloat width = bounds.size.width;
+		const CGFloat height = bounds.size.height;
+		const UIViewAutoresizing centred =
+			UIViewAutoresizingFlexibleWidth |
+			UIViewAutoresizingFlexibleTopMargin |
+			UIViewAutoresizingFlexibleBottomMargin;
+
+		_line = [[UILabel alloc] initWithFrame:CGRectMake(0, height / 2 - 60, width, 26)];
+		_line.textAlignment = NSTextAlignmentCenter;
+		_line.textColor = [UIColor whiteColor];
+		_line.font = [UIFont boldSystemFontOfSize:19];
+		_line.text = @"0 A.D.";
+		_line.autoresizingMask = centred;
+		[controller.view addSubview:_line];
+
+		_bar = [[UIProgressView alloc] initWithProgressViewStyle:UIProgressViewStyleDefault];
+		_bar.frame = CGRectMake(width * 0.2, height / 2 - 12, width * 0.6, 4);
+		_bar.autoresizingMask = centred;
+		[controller.view addSubview:_bar];
+
+		_detail = [[UILabel alloc] initWithFrame:CGRectMake(0, height / 2, width, 40)];
+		_detail.textAlignment = NSTextAlignmentCenter;
+		_detail.textColor = [UIColor colorWithWhite:0.7 alpha:1.0];
+		_detail.font = [UIFont systemFontOfSize:14];
+		_detail.numberOfLines = 2;
+		_detail.text = @"Fetching the game data. This happens once.";
+		_detail.autoresizingMask = centred;
+		[controller.view addSubview:_detail];
+
+		_retry = [UIButton buttonWithType:UIButtonTypeSystem];
+		_retry.frame = CGRectMake(width * 0.35, height / 2 + 50, width * 0.3, 40);
+		_retry.autoresizingMask = centred;
+		_retry.hidden = YES;
+		[controller.view addSubview:_retry];
+
+		_window.rootViewController = controller;
+		// Above whatever the launch screen left behind, below nothing: SDL's
+		// window does not exist yet.
+		_window.windowLevel = UIWindowLevelNormal + 1;
+		[_window makeKeyAndVisible];
+		[controller release];
+	});
+}
+
+- (void)setLine:(NSString*)line detail:(NSString*)detail fraction:(double)fraction
+{
+	dispatch_async(dispatch_get_main_queue(), ^{
+		if (line)
+			_line.text = line;
+		if (detail)
+			_detail.text = detail;
+		if (fraction >= 0)
+			[_bar setProgress:static_cast<float>(fraction) animated:NO];
+	});
+}
+
+- (void)showError:(NSString*)text retry:(void (^)(void))retry
+{
+	void (^again)(void) = [retry copy];
+	dispatch_async(dispatch_get_main_queue(), ^{
+		_line.text = @"The download did not finish";
+		_detail.text = text;
+		_bar.hidden = YES;
+		[_retry setTitle:@"Try again" forState:UIControlStateNormal];
+		// A block-backed action instead of a target and a selector: there is no
+		// object here that wants to own one. It carries an identifier so that a
+		// second failure replaces the action instead of adding another one --
+		// two actions would mean two downloads on the next tap.
+		[_retry removeActionForIdentifier:@"retry"
+			forControlEvents:UIControlEventTouchUpInside];
+		[_retry addAction:[UIAction actionWithTitle:@"" image:nil identifier:@"retry"
+			handler:^(__unused UIAction* action) {
+			_retry.hidden = YES;
+			_bar.hidden = NO;
+			_line.text = @"0 A.D.";
+			again();
+		}] forControlEvents:UIControlEventTouchUpInside];
+		_retry.hidden = NO;
+	});
+}
+
+- (void)hide
+{
+	dispatch_async(dispatch_get_main_queue(), ^{
+		_window.hidden = YES;
+		_window.rootViewController = nil;
+		[_window release];
+		_window = nil;
+	});
+}
