+
+ZeroADDownloadScreen* g_Screen = nil;
+std::function<void()> g_WhenReady;
+
+void Report(Progress& progress, const std::string& detail)
+{
+	// Six connections finishing chunks would otherwise redraw the bar hundreds
+	// of times a second.
+	const double now = CFAbsoluteTimeGetCurrent();
+	double before = progress.reportedAt.load();
+	if (now - before < 0.25)
+		return;
+	if (!progress.reportedAt.compare_exchange_strong(before, now))
+		return;
+
+	const long long done = progress.done.load();
+	const double fraction = progress.total > 0
+		? static_cast<double>(done) / static_cast<double>(progress.total) : 0.0;
+	NSString* text = [NSString stringWithFormat:@"%@%lld of %lld MB",
+		detail.empty() ? @"" : [NSString stringWithFormat:@"%@ — ", Str(detail)],
+		done / (1024 * 1024), progress.total / (1024 * 1024)];
+	[g_Screen setLine:nil detail:text fraction:fraction];
+}
+
+NSURLSession* MakeSession()
+{
+	NSURLSessionConfiguration* configuration =
+		[NSURLSessionConfiguration defaultSessionConfiguration];
+	// Without this the four connections iOS allows per host are all six requests
+	// get, and two of them just wait.
+	configuration.HTTPMaximumConnectionsPerHost = PARALLEL;
+	configuration.timeoutIntervalForRequest = 60;
+	// Nothing here is worth caching, and caching it would mean writing 3.5 GB
+	// twice onto a phone.
+	configuration.requestCachePolicy = NSURLRequestReloadIgnoringLocalCacheData;
+	configuration.URLCache = nil;
+	return [NSURLSession sessionWithConfiguration:configuration];
+}
+
+NSMutableURLRequest* RangeRequest(const std::string& url, long long begin, long long length)
+{
+	NSMutableURLRequest* request =
+		[NSMutableURLRequest requestWithURL:[NSURL URLWithString:Str(url)]];
+	[request setValue:[NSString stringWithFormat:@"bytes=%lld-%lld", begin, begin + length - 1]
+		forHTTPHeaderField:@"Range"];
+	return request;
+}
+
+/**
+ * Does the server answer a range with a range?
+ *
+ * Asked once, before anything big is fetched, because the failure it guards
+ * against is expensive: a server that ignores Range answers with the whole
+ * part, and a data task that has been handed 1.8 GB buffers all of it in memory
+ * before the completion handler ever gets to look at the status code. GitHub's
+ * asset storage does honour ranges; a mirror behind it might not.
+ */
+bool ServerHonoursRange(NSURLSession* session, const Source& source)
+{
+	const long long probe = std::min<long long>(1024, source.length);
+	if (probe <= 0)
+		return true;
+	dispatch_semaphore_t waiting = dispatch_semaphore_create(0);
+	__block bool ok = false;
+	NSURLSessionDataTask* task = [session dataTaskWithRequest:RangeRequest(source.url, 0, probe)
+		completionHandler:^(NSData* data, NSURLResponse* response, NSError* error)
+	{
+		NSHTTPURLResponse* http = [response isKindOfClass:[NSHTTPURLResponse class]]
+			? static_cast<NSHTTPURLResponse*>(response) : nil;
+		ok = !error && http.statusCode == 206 &&
+			static_cast<long long>(data.length) == probe;
+		if (!ok)
+			Note(@"range probe: status %ld, %lu bytes, %@",
+				static_cast<long>(http.statusCode), static_cast<unsigned long>(data.length),
+				error ? error.localizedDescription : @"no error");
+		dispatch_semaphore_signal(waiting);
+	}];
+	[task resume];
+	dispatch_semaphore_wait(waiting, DISPATCH_TIME_FOREVER);
+	return ok;
+}
+
+/**
+ * Fetch every chunk that is still missing, PARALLEL at a time.
+ */
+void OnePass(NSURLSession* session, FileJob& job, Progress& progress)
+{
+	dispatch_semaphore_t slots = dispatch_semaphore_create(PARALLEL);
+	dispatch_group_t group = dispatch_group_create();
+	// Not a std::mutex: a block copies the C++ objects it captures, and a mutex
+	// cannot be copied. This one is an object the block simply retains.
+	dispatch_semaphore_t stateLock = dispatch_semaphore_create(1);
+
+	for (long long index = 0; index < job.chunks; ++index)
+	{
+		if (job.state[index] == '1')
+			continue;
+		const long long begin = index * CHUNK;
+		const long long length = ChunkLength(job, index);
+		// Which part the chunk is in, and where inside that part it sits. The
+		// manifest is checked to cut parts on chunk boundaries, so a chunk never
+		// straddles two of them.
+		const Source* source = SourceAt(job.entry, begin);
+		if (!source)
+		{
+			Note(@"chunk %lld of %s has no part", index, job.entry.path.c_str());
+			continue;
+		}
+		const long long within = begin - source->offset;
+		const bool wholePart = within == 0 && length == source->length;
+
+		dispatch_semaphore_wait(slots, DISPATCH_TIME_FOREVER);
+		dispatch_group_enter(group);
+		NSURLSessionDataTask* task =
+			[session dataTaskWithRequest:RangeRequest(source->url, within, length)
+			completionHandler:^(NSData* data, NSURLResponse* response, NSError* error)
+		{
+			NSHTTPURLResponse* http = [response isKindOfClass:[NSHTTPURLResponse class]]
+				? static_cast<NSHTTPURLResponse*>(response) : nil;
+			const bool answered = !error && http &&
+				(http.statusCode == 206 ||
+					// 200 is only the honest answer when the range covered the
+					// whole part; otherwise the server ignored Range and this
+					// body does not belong at this offset.
+					(http.statusCode == 200 && wholePart));
+			if (!answered || static_cast<long long>(data.length) != length)
+			{
+				Note(@"chunk %lld of %s: status %ld, %lu bytes, %@", index,
+					job.entry.path.c_str(), static_cast<long>(http.statusCode),
+					static_cast<unsigned long>(data.length),
+					error ? error.localizedDescription : @"wrong length");
+			}
+			else if (!WriteAt(job.fd, data.bytes, data.length, begin))
+			{
+				Note(@"chunk %lld of %s: cannot write (%s)", index,
+					job.entry.path.c_str(), std::strerror(errno));
+			}
+			else
+			{
+				dispatch_semaphore_wait(stateLock, DISPATCH_TIME_FOREVER);
+				job.state[index] = '1';
+				WriteState(job);
+				dispatch_semaphore_signal(stateLock);
+				progress.done += length;
+				Report(progress, job.entry.path);
+			}
+			dispatch_semaphore_signal(slots);
+			dispatch_group_leave(group);
+		}];
+		[task resume];
+	}
+	dispatch_group_wait(group, DISPATCH_TIME_FOREVER);
+}
+
+/**
+ * The one-connection fallback, for a server that does not do ranges.
+ */
+bool FetchWholeSources(NSURLSession* session, FileJob& job, Progress& progress)
+{
+	for (const Source& source : job.entry.sources)
+	{
+		Report(progress, job.entry.path);
+		dispatch_semaphore_t waiting = dispatch_semaphore_create(0);
+		// A download task streams to a file of its own, so even 1.8 GB does not
+		// go through memory. From there it is copied to where it belongs, which
+		// costs a second pass over the bytes -- acceptable for a path that is
+		// only taken when the server cannot do ranges at all.
+		__block NSString* temporaryPath = nil;
+		NSURLSessionDownloadTask* task =
+			[session downloadTaskWithURL:[NSURL URLWithString:Str(source.url)]
+			completionHandler:^(NSURL* temporary, NSURLResponse* response, NSError* error)
+		{
+			NSHTTPURLResponse* http = [response isKindOfClass:[NSHTTPURLResponse class]]
+				? static_cast<NSHTTPURLResponse*>(response) : nil;
+			if (!error && http.statusCode == 200 && temporary)
+			{
+				// The task deletes its file as soon as the handler returns.
+				NSString* kept = [NSTemporaryDirectory()
+					stringByAppendingPathComponent:@"0ad-part"];
+				[[NSFileManager defaultManager] removeItemAtPath:kept error:nil];
+				if ([[NSFileManager defaultManager] moveItemAtPath:temporary.path
+						toPath:kept error:nil])
+					temporaryPath = [kept retain];
+			}
+			if (!temporaryPath)
+				Note(@"part of %s: status %ld, %@", job.entry.path.c_str(),
+					static_cast<long>(http.statusCode),
+					error ? error.localizedDescription : @"could not be kept");
+			dispatch_semaphore_signal(waiting);
+		}];
+		[task resume];
+		dispatch_semaphore_wait(waiting, DISPATCH_TIME_FOREVER);
+		if (!temporaryPath)
+			return false;
+
+		bool ok = false;
+		if (FILE* file = std::fopen(temporaryPath.UTF8String, "r"))
+		{
+			std::vector<char> buffer(1024 * 1024);
+			long long at = source.offset;
+			ok = true;
+			while (const std::size_t got =
+				std::fread(buffer.data(), 1, buffer.size(), file))
+			{
+				if (!WriteAt(job.fd, buffer.data(), got, at))
+				{
+					ok = false;
+					break;
+				}
+				at += got;
+			}
+			ok = ok && at == source.offset + source.length;
+			std::fclose(file);
+		}
+		[[NSFileManager defaultManager] removeItemAtPath:temporaryPath error:nil];
+		[temporaryPath release];
+		if (!ok)
+		{
+			Note(@"part of %s: could not be written into place", job.entry.path.c_str());
+			return false;
+		}
+		progress.done += source.length;
+		Report(progress, job.entry.path);
+	}
+	// Nothing was tracked chunk by chunk here, so say so in one go: the hash
+	// check below is what decides whether this worked.
+	job.state.assign(static_cast<std::size_t>(job.chunks), '1');
+	WriteState(job);
+	return true;
+}
+
+bool DoDownload(std::string& error)
+{
+	const std::string partial = DataPartial();
+	const std::string final = DataFinal();
+	if (partial.empty())
+	{
+		error = "there is no Application Support directory to write to";
+		return false;
+	}
+
+	std::vector<Entry> entries;
+	if (!ReadManifest(entries, error))
+		return false;
+
+	if (!MakeDirs(partial))
+	{
+		error = "cannot create the data directory";
+		return false;
+	}
+
+	Progress progress;
+	std::vector<FileJob> jobs;
+	jobs.reserve(entries.size());
+	for (Entry& entry : entries)
+	{
+		FileJob job;
+		job.entry = entry;
+		job.target = partial + "/" + entry.path;
+		job.statePath = job.target + ".parts";
+		job.chunks = (entry.size + CHUNK - 1) / CHUNK;
+
+		const std::size_t slash = job.target.find_last_of('/');
+		if (slash != std::string::npos && !MakeDirs(job.target.substr(0, slash)))
+		{
+			error = "cannot create " + entry.path;
+			return false;
+		}
+		job.fd = open(job.target.c_str(), O_RDWR | O_CREAT, 0644);
+		if (job.fd < 0 || ftruncate(job.fd, entry.size) != 0)
+		{
+			error = "cannot write " + entry.path + " (" + std::strerror(errno) + ")";
+			return false;
+		}
+		ReadState(job);
+		progress.total += entry.size;
+		progress.done += DoneBytes(job);
+		jobs.push_back(std::move(job));
+	}
+
+	const long long missing = progress.total - progress.done.load();
+	NSDictionary* attributes = [[NSFileManager defaultManager]
+		attributesOfFileSystemForPath:Str(partial) error:nil];
+	const long long available = [attributes[NSFileSystemFreeSize] longLongValue];
+	if (available > 0 && available < missing + SPARE)
+	{
+		char text[256];
+		std::snprintf(text, sizeof(text),
+			"%lld MB are needed and %lld MB are free. Make room and try again.",
+			(missing + SPARE) / (1024 * 1024), available / (1024 * 1024));
+		error = text;
+		return false;
+	}
+	Note(@"%lld MB to fetch, %lld MB free", missing / (1024 * 1024),
+		available / (1024 * 1024));
+
+	NSURLSession* session = MakeSession();
+	const bool ranges = ServerHonoursRange(session, jobs.front().entry.sources.front());
+	Note(@"ranges: %s", ranges ? "yes, six at a time" : "no, one connection");
+
+	bool ok = true;
+	for (FileJob& job : jobs)
+	{
+		if (ranges)
+		{
+			for (int pass = 0; pass < PASSES && !AllDone(job); ++pass)
+			{
+				if (pass > 0)
+				{
+					Note(@"%s: pass %d", job.entry.path.c_str(), pass + 1);
+					[NSThread sleepForTimeInterval:2.0 * pass];
+				}
+				OnePass(session, job, progress);
+			}
+			ok = AllDone(job);
+		}
+		else
+			ok = FetchWholeSources(session, job, progress);
+
+		if (job.fd >= 0)
+		{
+			close(job.fd);
+			job.fd = -1;
+		}
+		if (!ok)
+		{
+			error = job.entry.path + " did not come down completely";
+			break;
+		}
+
+		[g_Screen setLine:nil detail:Str("Checking " + job.entry.path) fraction:-1];
+		if (!VerifyHash(job.target, job.entry.sha256))
+		{
+			// Something changed under us, or a chunk arrived wrong and said it
+			// was right. Throw the file away so that trying again starts over
+			// instead of hashing the same bad bytes.
+			unlink(job.target.c_str());
+			unlink(job.statePath.c_str());
+			error = job.entry.path + " arrived damaged (checksum)";
+			ok = false;
+			break;
+		}
+		unlink(job.statePath.c_str());
+		Note(@"%s: complete and verified", job.entry.path.c_str());
+	}
+
+	// Descriptors of files that were never reached.
+	for (FileJob& job : jobs)
+		if (job.fd >= 0)
+			close(job.fd);
+	if (!ok)
+		return false;
+
+	NSFileManager* files = [NSFileManager defaultManager];
+	// Only now does the directory get the name Paths::RootData() looks for.
+	[files removeItemAtPath:Str(final) error:nil];
+	if (![files moveItemAtPath:Str(partial) toPath:Str(final) error:nil])
+	{
+		error = "the data could not be moved into place";
+		return false;
+	}
+	Note(@"data complete in %s", final.c_str());
+	return true;
+}
+
+void StartAttempt()
+{
+	dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+		NSAutoreleasePool* pool = [[NSAutoreleasePool alloc] init];
+		std::string error;
+		const bool ok = DoDownload(error);
+		if (!ok)
+			Note(@"failed: %s", error.c_str());
+		NSString* message = ok ? @"" : Str(error);
+		[message retain];
+		[pool release];
+
+		dispatch_async(dispatch_get_main_queue(), ^{
+			if (ok)
+			{
+				[g_Screen hide];
+				if (g_WhenReady)
+					g_WhenReady();
+			}
+			else
+				[g_Screen showError:message retry:^{ StartAttempt(); }];
+			[message release];
+		});
+	});
+}
+
+} // anonymous namespace
+
+bool ios_IsDataPresent()
+{
+	// mods, not config: a directory with only config in it is what an
+	// interrupted first start leaves behind, and the engine cannot mount it.
+	const std::string data = DataFinal();
+	if (!data.empty() && DirExists(data + "/mods"))
+		return true;
+	// A self-contained build has the data in the bundle. That is how the
+	// simulator smoke test runs, and then nothing is downloaded at all.
+	return DirExists(osx_GetBundleResourcesPath() + "/data/mods");
+}
+
+void ios_DownloadData(std::function<void()> whenReady)
+{
+	g_WhenReady = std::move(whenReady);
+	if (!g_Screen)
+		g_Screen = [[ZeroADDownloadScreen alloc] init];
+	[g_Screen show];
+	Note(@"no game data yet -- fetching it");
+	StartAttempt();
+}
